#!/usr/bin/env python3
"""Stateful mock of `iptables -t mangle` for host tests of wan-affinity.sh.

Only the operations the controller uses are implemented. State lives in a JSON
file named by $IPT_STATE; every invocation is appended to $MOCK_LOG.
"""
import json
import os
import sys

STATE = os.environ.get("IPT_STATE", "/tmp/wan_affinity_ipt_state.json")
LOG = os.environ.get("MOCK_LOG")


def load():
    try:
        with open(STATE) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {"chains": {"PREROUTING": []}}


def save(state):
    with open(STATE, "w") as fh:
        json.dump(state, fh)


def main(argv):
    state = load()
    chains = state.setdefault("chains", {})
    chains.setdefault("PREROUTING", [])
    if LOG:
        with open(LOG, "a") as fh:
            fh.write("iptables " + " ".join(argv) + "\n")

    args = argv[:]
    if len(args) >= 2 and args[0] == "-t":
        args = args[2:]
    if not args:
        return 2
    op = args[0]

    fail_contains=os.environ.get("IPT_FAIL_CONTAINS")
    if fail_contains and fail_contains in " ".join(args):
        return 1

    if op == "-S":
        selected = [args[1]] if len(args)>1 else list(chains)
        for chain in selected:
            if chain not in chains: return 1
            if chain=="PREROUTING": print("-P PREROUTING ACCEPT")
            else: print("-N "+chain)
            for rule in chains[chain]:
                print("-A %s %s" % (chain, " ".join(rule)))
        return 0

    if op == "-A":
        chain, rule = args[1], args[2:]
        if chain not in chains:
            return 1
        chains[chain].append(rule)
        save(state)
        return 0

    if op == "-I":
        chain, pos, rule = args[1], int(args[2]), args[3:]
        if chain not in chains:
            return 1
        if "-j" in rule and rule[rule.index("-j")+1].startswith("WA_") and rule[rule.index("-j")+1] not in chains:
            return 1
        chains[chain].insert(pos - 1, rule)
        save(state)
        return 0

    if op == "-D":
        chain, rule = args[1], args[2:]
        if chain not in chains:
            return 1
        for i, existing in enumerate(chains[chain]):
            if existing == rule:
                del chains[chain][i]
                save(state)
                return 0
        return 1

    if op == "-C":
        return 0 if args[2:] in chains.get(args[1],[]) else 1

    if op == "-N":
        chain = args[1]
        if chain in chains:
            return 1
        chains[chain] = []
        save(state)
        return 0

    if op == "-F":
        chain = args[1]
        if chain not in chains:
            return 1
        chains[chain] = []
        save(state)
        return 0

    if op == "-X":
        chain = args[1]
        if chain not in chains or chains[chain]:
            return 1
        if any("-j" in r and r[r.index("-j")+1]==chain for rules in chains.values() for r in rules):return 1
        del chains[chain]
        save(state)
        return 0

    # -n -L [chain]
    if op in ("-n", "-L"):
        chain = None
        for i, a in enumerate(args):
            if a == "-L" and i + 1 < len(args):
                chain = args[i + 1]
        if chain is None:
            return 0
        if chain in chains:
            print("Chain %s (policy ACCEPT)" % chain)
            return 0
        print("iptables: No chain/target/match by that name.")
        return 1

    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
